{
	"ci": {
		"collect": {
			"staticDistDir": "_site",
			"numberOfRuns": 3,
			"settings": {
				"chromeFlags": "--no-sandbox --disable-dev-shm-usage"
			}
		},
		"assert": {
			"assertions": {
				"categories:best-practices": [
					"error",
					{
						"minScore": 0.9
					}
				],
				"categories:accessibility": "off",
				"categories:performance": [
					"error",
					{
						"minScore": 0.9
					}
				],
				"categories:seo": "off",
				"uses-long-cache-ttl": "off",
				"is-crawlable": "off"
			}
		},
		"upload": {
			"target": "filesystem",
			"outputDir": ".lighthouseci"
		}
	}
}
