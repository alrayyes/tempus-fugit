{
	"name": "tempus-fugit",
	"version": "1.3.3",
	"private": true,
	"description": "Outpost landing page",
	"keywords": [
		"astro"
	],
	"bugs": {
		"url": "https://github.com/alrayyes/tempus-fugit/issues"
	},
	"repository": "https://github.com/alrayyes/tempus-fugit",
	"license": "GPL-3.0-or-later",
	"author": "alrayyes",
	"scripts": {
		"build": "astro build",
		"format": "prettier --write '**/*.{md,yml,yaml}'",
		"format:check": "prettier --check '**/*.{md,yml,yaml}'",
		"lint": "biome check && astro check",
		"lint:fix": "biome check --write",
		"lint:md": "markdownlint-cli2",
		"lint:md:fix": "markdownlint-cli2 --fix",
		"lint:prose": "vale README.md CONTRIBUTING.md",
		"prepare": "test -n \"$CI\" || lefthook install",
		"preview": "astro preview",
		"start": "astro dev",
		"test": "bats test/",
		"test:coverage": "scripts/coverage.sh",
		"test:e2e": "scripts/e2e.sh",
		"test:lighthouse": "lhci autorun"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.10",
		"@axe-core/playwright": "4.13.0",
		"@biomejs/biome": "2.5.10",
		"@commitlint/cli": "21.2.2",
		"@commitlint/config-conventional": "21.2.2",
		"@fission-ai/openspec": "1.11.0",
		"@lhci/cli": "0.15.1",
		"@playwright/test": "1.62.1",
		"@tailwindcss/vite": "4.3.3",
		"astro": "7.2.10",
		"bats": "1.13.0",
		"lefthook": "2.1.12",
		"markdownlint-cli2": "0.23.2",
		"prettier": "3.9.6",
		"tailwindcss": "4.3.3",
		"typescript": "5.9.3"
	},
	"packageManager": "bun@1.3.14",
	"trustedDependencies": [
		"@biomejs/biome",
		"@tailwindcss/oxide",
		"esbuild",
		"lefthook",
		"sharp"
	],
	"overrides": {
		"qs": "6.16.0"
	}
}
